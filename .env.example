# Chiave API di Resend per l'invio dei preventivi (https://resend.com). Lascia vuoto per disattivare l'invio online.
RESEND_API_KEY=

# Indirizzo che riceve le richieste di preventivo. Se vuoto usa l'email di content/site.json.
# PREVENTIVO_TO=

# Mittente delle email. Deve essere un dominio verificato su Resend. Se vuoto usa onboarding@resend.dev.
# PREVENTIVO_FROM=
